'calculating the impact of various scenarios';

CREATE TABLE stress_values AS
SELECT
    scenario_name,
    total_portfolio_value,
    shock_pct,
    total_portfolio_value * (1 + shock_pct / 100.0) AS stressed_value
FROM portfolio_value
CROSS JOIN stress_scenarios;

